{
  "manifest_version": 3,
  "name": "Canvas Sidebar Toggle",
  "version": "1.0.0",
  "description": "Hide or show Canvas's global navigation and course menu, letting the main content use the freed space.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://canvas.anglia.ac.uk/*",
    "https://*.instructure.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://canvas.anglia.ac.uk/*",
        "https://*.instructure.com/*"
      ],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Canvas Sidebar Toggle",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "toggle-global-nav": {
      "suggested_key": { "default": "Alt+Shift+G" },
      "description": "Hide/show the global navigation"
    },
    "toggle-course-menu": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "Hide/show the course menu"
    },
    "toggle-full-width": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Toggle full-width content"
    }
  }
}
